# Copy to .env and customize for local Postgres, Docker Compose, or Supabase Cloud PostgreSQL

# Local Application Port
APP_PORT=8080

# -----------------------------------------------------------------------------
# 1. Local Docker container (om-pg16-test) defaults:
# -----------------------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5433/om_test
DB_USERNAME=postgres
DB_PASSWORD=testpass

# -----------------------------------------------------------------------------
# 2. Supabase PostgreSQL Session Pooler (Production/Staging):
# -----------------------------------------------------------------------------
# SPRING_PROFILES_ACTIVE=supabase
# DB_HOST=aws-0-ap-south-1.pooler.supabase.com
# DB_PORT=5432
# DB_NAME=postgres
# DB_USERNAME=postgres.dpckliukvkdwerjqbxhu
# DB_PASSWORD=your_supabase_password_here

# -----------------------------------------------------------------------------
# 3. Local Docker Compose defaults (if using docker-compose up):
# -----------------------------------------------------------------------------
# DB_URL=jdbc:postgresql://db:5432/omrestaurant
# DB_USERNAME=omrestaurant
# DB_PASSWORD=omrestaurant_dev
# POSTGRES_DB=omrestaurant
# POSTGRES_USER=omrestaurant
# POSTGRES_PASSWORD=omrestaurant_dev
