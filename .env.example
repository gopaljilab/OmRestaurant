# Copy to .env and customize for Supabase Cloud PostgreSQL or custom local Postgres

# Local Docker Compose PostgreSQL defaults
APP_PORT=8080
POSTGRES_DB=omrestaurant
POSTGRES_USER=omrestaurant
POSTGRES_PASSWORD=omrestaurant_dev

# Spring Boot Datasource (defaults in docker-compose point to the local 'db' container)
# For Supabase PostgreSQL, uncomment and populate with your project pooler credentials:
# DB_URL=jdbc:postgresql://aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require
# DB_USERNAME=postgres.ujiftprtpulyhudloyvp
# DB_PASSWORD=your-supabase-password
DB_URL=jdbc:postgresql://db:5432/omrestaurant
DB_USERNAME=omrestaurant
DB_PASSWORD=omrestaurant_dev
