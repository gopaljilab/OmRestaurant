# Copy to .env and customize for local Postgres, Docker Compose, Supabase Cloud PostgreSQL, and Vercel
# =============================================================================
# OM Restaurant & KDS Environment Variables
# =============================================================================

# Application Server Port
APP_PORT=8080

# -----------------------------------------------------------------------------
# 1. Supabase PostgreSQL Session Pooler (Production / Cloud Database):
# -----------------------------------------------------------------------------
# SPRING_PROFILES_ACTIVE=supabase
# DB_HOST=aws-0-ap-south-1.pooler.supabase.com
# DB_PORT=5432
# DB_NAME=postgres
# DB_USERNAME=postgres.dpckliukvkdwerjqbxhu
# DB_PASSWORD=your_supabase_password_here
# DATABASE_URL=postgresql://postgres.dpckliukvkdwerjqbxhu:your_supabase_password_here@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# -----------------------------------------------------------------------------
# 2. Local Docker container (om-pg16-test) defaults:
# -----------------------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5433/om_test
DB_USERNAME=postgres
DB_PASSWORD=testpass

# -----------------------------------------------------------------------------
# 3. EmailJS Notification Service (Customer Reservation & Contact Emails):
# -----------------------------------------------------------------------------
EMAILJS_PUBLIC_KEY=oMUTFQVOur_fOnw_t
EMAILJS_SERVICE_ID=service_da1y4nn
EMAILJS_BOOKING_TEMPLATE_ID=template_7uffzct
EMAILJS_NEWSLETTER_TEMPLATE_ID=template_0by6ed7
EMAILJS_CONTACT_PUBLIC_KEY=OVv3HY-kOjQfzS0GV
EMAILJS_CONTACT_SERVICE_ID=service_lf56m2o
EMAILJS_CONTACT_TEMPLATE_ID=template_e6tjmba

# -----------------------------------------------------------------------------
# 4. KDS Operations Frontend (React / Vite):
# -----------------------------------------------------------------------------
# Leave empty for local Vite dev proxy to http://localhost:8080
# Set to your live backend domain when deployed on Vercel
VITE_API_BASE_URL=
